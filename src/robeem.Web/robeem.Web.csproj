<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Tenant connection strings with passwords live in user-secrets, never in appsettings. -->
    <UserSecretsId>robeem-attendance-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\robeem.HR\robeem.HR.csproj" />
    <ProjectReference Include="..\robeem.Infrastructure\robeem.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Startup project for `dotnet ef`. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
