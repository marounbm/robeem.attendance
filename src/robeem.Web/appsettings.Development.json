{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Tenancy": {
    "AllowUnauthenticatedTenantSelection": true,
    "DefaultTenantId": "demo",
    "Tenants": [
      {
        "Id": "demo",
        "Name": "Demo Company",
        "ConnectionString": "Host=localhost;Database=robeem_demo;Username=postgres"
      },
      {
        "Id": "acme",
        "Name": "Acme Corporation",
        "ConnectionString": "Host=localhost;Database=robeem_acme;Username=postgres"
      }
    ]
  }
}
