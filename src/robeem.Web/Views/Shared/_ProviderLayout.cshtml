@model robeem.Contracts.Attendance.ProviderMappingGuide
@{
    var guide = Model;
}

<p>@guide.Summary</p>
<div class="row g-3">
    <div class="col-lg-6">
        <h2 class="h6">Fields</h2>
        @if (guide.Fields.Count == 0)
        {
            <p class="text-muted small mb-0">Not described.</p>
        }
        else
        {
            <table class="table table-sm small mb-0">
                <thead><tr><th>Vendor field</th><th>Becomes</th><th></th></tr></thead>
                <tbody>
                    @foreach (var field in guide.Fields)
                    {
                        <tr><td><code>@field.Source</code></td><td><code>@field.Target</code></td><td class="text-muted">@field.Note</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-3">
        <h2 class="h6">Event labels</h2>
        @if (guide.EventCodes.Count == 0)
        {
            <p class="text-muted small mb-0">Not described.</p>
        }
        else
        {
            <table class="table table-sm small mb-0">
                <thead><tr><th>Label</th><th>Event</th></tr></thead>
                <tbody>
                    @foreach (var code in guide.EventCodes)
                    {
                        <tr><td><code>@code.Code</code></td><td>@code.EventType</td></tr>
                    }
                </tbody>
            </table>
            <p class="small text-muted mt-1 mb-0">Any other label fails the row; nothing is guessed.</p>
        }
    </div>
    <div class="col-lg-3">
        <h2 class="h6">Timestamp formats</h2>
        <ul class="small mb-2">
            @foreach (var format in guide.TimestampFormats)
            {
                <li><code>@format</code></li>
            }
        </ul>
        @if (guide.NotStored.Count > 0)
        {
            <h2 class="h6">Never stored</h2>
            <ul class="small mb-0">
                @foreach (var item in guide.NotStored)
                {
                    <li>@item</li>
                }
            </ul>
        }
    </div>
</div>
