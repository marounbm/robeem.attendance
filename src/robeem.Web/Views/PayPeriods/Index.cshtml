@model PayPeriodsIndexViewModel
@{
    ViewData["Title"] = "Pay periods";
}

<h1 class="h3 mb-3">Pay periods</h1>

<p class="text-muted">
    The dates payroll pays for. While a period is open, payroll can read its approved days. Closing a period ends that:
    payroll receives none of its days. Reopening a closed period needs a reason, which is kept in the audit log.
</p>

<partial name="_StatusMessage" />

<div class="card mb-4">
    <div class="card-header">New pay period</div>
    <div class="card-body">
        <form method="post" asp-action="Create" class="row g-3 align-items-start">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12 mb-0" role="alert"></div>
            <div class="col-md-3">
                <label asp-for="Input.StartDate" class="form-label"></label>
                <input asp-for="Input.StartDate" type="date" value="@Model.Input.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.EndDate" class="form-label"></label>
                <input asp-for="Input.EndDate" type="date" value="@Model.Input.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
            </div>
            <div class="col-md-3 pt-4">
                <button type="submit" class="btn btn-primary mt-2">Create</button>
            </div>
            <div class="col-12 form-text">A period can't overlap another one, and runs at most 366 days. It starts open.</div>
        </form>
    </div>
</div>

<div class="card">
    @if (Model.Periods.Count == 0)
    {
        <div class="card-body text-muted">No pay periods yet. Create the first one above.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">First day</th>
                        <th scope="col">Last day</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var period in Model.Periods)
                    {
                        <tr>
                            <td class="text-nowrap">@DisplayFormats.Date(period.StartDate)</td>
                            <td class="text-nowrap">@DisplayFormats.Date(period.EndDate)</td>
                            <td><span class="badge text-bg-@(period.IsClosed ? "secondary" : "success")">@(period.IsClosed ? "Closed" : "Open")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Payroll" asp-action="Index" asp-route-periodId="@period.Id">Payroll</a>
                                @if (period.IsClosed)
                                {
                                    <details class="d-inline-block text-start">
                                        <summary class="btn btn-sm btn-outline-secondary">Reopen…</summary>
                                        <form method="post" asp-action="Reopen" asp-route-id="@period.Id" class="mt-2">
                                            <label class="form-label small mb-0" for="reason-@period.Id">Why is it reopened?</label>
                                            <textarea id="reason-@period.Id" name="reason" class="form-control form-control-sm" rows="2" maxlength="1000" required></textarea>
                                            <button type="submit" class="btn btn-sm btn-warning mt-1">Reopen period</button>
                                        </form>
                                    </details>
                                }
                                else
                                {
                                    <form method="post" asp-action="Close" asp-route-id="@period.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Close this pay period? Payroll will receive none of its days.');">Close</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
