@model ConnectorsIndexViewModel
@{
    ViewData["Title"] = "Connectors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Connectors</h1>
    <a class="btn btn-primary" asp-action="Create">Add connector</a>
</div>

<p class="text-muted">
    A connector is one software or protocol of a <a asp-controller="Vendors" asp-action="Index">vendor</a>: its desktop export, its REST API, its push
    protocol. An integration is made with one. A connector is <strong>usable</strong> when it and its vendor are active and something can read what it
    delivers: a <em>default payload format</em> (for exported files) or a <em>code adapter</em> registered under its adapter key (for a pull or a push).
    A connector is deactivated, never deleted.
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Connectors.Count == 0)
    {
        <div class="card-body text-muted">No connectors yet. <a asp-action="Create">Add the first one.</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Connector</th>
                        <th scope="col">Vendor</th>
                        <th scope="col">Transports</th>
                        <th scope="col">Default payload format</th>
                        <th scope="col">Payload kinds</th>
                        <th scope="col">Code adapter</th>
                        <th scope="col" class="text-end">Integrations</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Connectors)
                    {
                        <tr>
                            <td>
                                @item.DisplayName
                                <div class="small text-muted"><code>@item.ConnectorKey</code></div>
                            </td>
                            <td>@item.VendorName</td>
                            <td>File upload@(item.Transports.Count > 0 ? ", " + string.Join(", ", item.Transports) : string.Empty)</td>
                            <td>@(item.DefaultPayloadFormatName ?? "—")</td>
                            <td>@(item.PayloadKinds.Count > 0 ? string.Join(", ", item.PayloadKinds) : "—")</td>
                            <td>@(item.HasAdapter ? item.AdapterKey : "No")</td>
                            <td class="text-end">@item.IntegrationCount</td>
                            <td>
                                @if (item.IsUsable)
                                {
                                    <span class="badge text-bg-success">Usable</span>
                                }
                                else if (item.IsActive)
                                {
                                    <span class="badge text-bg-warning" title="Active, but it has neither a default payload format nor a code adapter (or its vendor is inactive).">Nothing reads it</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
