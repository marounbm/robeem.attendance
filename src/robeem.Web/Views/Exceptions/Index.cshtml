@model ExceptionsIndexViewModel
@{
    ViewData["Title"] = "Exceptions";
    var days = Model.Days;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Exceptions</h1>
</div>

<p class="text-muted">
    The days that have a problem a person has to settle: a missing punch, punches in the wrong order, or a break outside the rules. You see your
    own; a manager also sees their reports'; HR sees everyone's. To put one of your days right, press <strong>Correct</strong>: it shows every
    punch of the day, and you can change a punch, add one that is missing, or ignore one that should not count. Your approver then decides.
</p>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="status">Show</label>
        <select id="status" name="status" class="form-select">
            @foreach (var status in ExceptionsIndexViewModel.Statuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@DisplayFormats.Words(status)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="from">From</label>
        <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="to">To</label>
        <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="card">
    @if (days.Count == 0)
    {
        <div class="card-body text-muted">No days with exceptions match.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Employee</th>
                        <th scope="col">Shift</th>
                        <th scope="col">Problems</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in days)
                    {
                        var key = $"{day.EmployeeId}-{day.Date:yyyyMMdd}";
                        <tr>
                            <td class="text-nowrap">
                                <a asp-controller="Records" asp-action="Day" asp-route-employeeId="@day.EmployeeId"
                                   asp-route-date="@day.Date.ToString("yyyy-MM-dd")">@DisplayFormats.Date(day.Date)</a>
                            </td>
                            <td>@day.EmployeeName</td>
                            <td>@string.Join(", ", day.Shifts)</td>
                            <td>
                                <button class="btn btn-link btn-sm p-0 text-start" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#day-@key" aria-expanded="false" aria-controls="day-@key">
                                    @day.Items.Count problem@(day.Items.Count == 1 ? string.Empty : "s")
                                </button>
                            </td>
                            <td><span class="badge text-bg-@DisplayFormats.Badge(day.Status)">@DisplayFormats.Words(day.Status)</span></td>
                            <td class="text-end">
                                @if (day.CanCorrect)
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Correct" asp-route-date="@day.Date.ToString("yyyy-MM-dd")">Correct</a>
                                }
                                else if (day.IsWaiting)
                                {
                                    <span class="small text-muted">Waiting for approval</span>
                                }
                            </td>
                        </tr>
                        <tr class="collapse" id="day-@key">
                            <td colspan="6" class="bg-light">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var item in day.Items)
                                    {
                                        <li class="py-1">
                                            <span class="badge text-bg-@DisplayFormats.Badge(item.Status)">@DisplayFormats.Words(item.Status)</span>
                                            @if (item.MissingEventType is not null)
                                            {
                                                <span>Missing @DisplayFormats.Words(item.MissingEventType).ToLowerInvariant()</span>
                                            }
                                            else if (item.ExceptionType is "LongBreak" or "LateBreak" or "EarlyBreak")
                                            {
                                                <span>@DisplayFormats.Words(item.ExceptionType)</span>
                                            }
                                            else
                                            {
                                                <span>Wrong order</span>
                                            }
                                            <span class="small text-muted"> · @item.Description</span>
                                            @if (item.ResolutionMethod is not null)
                                            {
                                                <div class="small text-muted ms-2">@DisplayFormats.Words(item.ResolutionMethod)@(string.IsNullOrWhiteSpace(item.ResolutionNote) ? string.Empty : ": " + item.ResolutionNote)</div>
                                            }

                                            @if (item.CanAccept)
                                            {
                                                <form method="post" asp-action="Accept" class="row g-2 align-items-end mt-1 ms-2">
                                                    <input type="hidden" name="exceptionId" value="@item.Id" />
                                                    <div class="col-md-7">
                                                        <label class="form-label small mb-0" for="accept-why-@item.Id">Accept this as it is: why?</label>
                                                        <input id="accept-why-@item.Id" type="text" name="reason" maxlength="1000" class="form-control form-control-sm" required />
                                                    </div>
                                                    <div class="col-md-3">
                                                        <button type="submit" class="btn btn-sm btn-outline-primary">Accept exception</button>
                                                    </div>
                                                </form>
                                            }
                                        </li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
