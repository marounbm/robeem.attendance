@model ExceptionsIndexViewModel
@{
    ViewData["Title"] = "Attendance";
    var groups = Model.Groups;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Attendance</h1>
</div>

<partial name="_AttendanceTabs" model="@("Exceptions")" />

<p class="text-muted">
    The problems found on an employee's shift, kept together as one case: a missing punch, punches in the wrong order, or a break or a day outside
    the rules. You see your own; a manager also sees their reports'; HR sees everyone's. To put a day right, press <strong>Correct</strong>:
    it shows every punch of the day, and you can change a punch, add one that is missing, or ignore one that should not count. The approver then
    decides. A manager (for their reports) or HR can correct a day <strong>on the employee's behalf</strong>, giving the reason: they take the
    approval step that is theirs, so what is left, if anything, waits for the other approver. A manager or HR can also <strong>accept</strong>
    a case as it is, with one reason, when none of its problems needs a punch.
</p>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="status">Show</label>
        <select id="status" name="status" class="form-select">
            @foreach (var status in ExceptionsIndexViewModel.Statuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@DisplayFormats.Words(status)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="employeeId">Employee</label>
        <select id="employeeId" name="employeeId" class="form-select">
            <option value="">All employees</option>
            @foreach (var employee in Model.Employees)
            {
                <option value="@employee.Id" selected="@(employee.Id == Model.EmployeeId)">@employee.Name</option>
            }
        </select>
    </div>
    <partial name="_MonthPicker" model="@((Model.From, Model.To))" />
    <div class="col-auto">
        <label class="form-label small mb-0" for="from">From</label>
        <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="to">To</label>
        <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select">
            @foreach (var size in ExceptionsIndexViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="card">
    @if (groups.Count == 0)
    {
        <div class="card-body text-muted">No exceptions match.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Employee</th>
                        <th scope="col">Shift</th>
                        <th scope="col">Problems</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in groups)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <a asp-controller="Records" asp-action="Day" asp-route-employeeId="@group.EmployeeId"
                                   asp-route-date="@group.AttendanceDate.ToString("yyyy-MM-dd")">@DisplayFormats.Date(group.AttendanceDate)</a>
                            </td>
                            <td>@group.EmployeeName</td>
                            <td>@(group.ShiftTitle ?? "Unscheduled work")</td>
                            <td>
                                <button class="btn btn-link btn-sm p-0 text-start" type="button" data-bs-toggle="collapse"
                                        data-bs-target="#group-@group.Id" aria-expanded="false" aria-controls="group-@group.Id">
                                    @group.Exceptions.Count problem@(group.Exceptions.Count == 1 ? string.Empty : "s")
                                </button>
                            </td>
                            <td>
                                <span class="badge text-bg-@DisplayFormats.Badge(group.Status)">@DisplayFormats.Words(group.Status)</span>
                                @if (group.ResolutionMethod is not null)
                                {
                                    <div class="small text-muted">
                                        @DisplayFormats.Words(group.ResolutionMethod)@(group.ResolvedByName is null ? string.Empty : " by " + group.ResolvedByName)
                                    </div>
                                }
                            </td>
                            <td class="text-end">
                                @if (group.CanCorrect)
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Correct" asp-route-date="@group.AttendanceDate.ToString("yyyy-MM-dd")" asp-route-employeeId="@group.EmployeeId" aria-label="Correct the day of @group.EmployeeName">Correct</a>
                                }
                                else if (group.IsWaiting)
                                {
                                    <span class="small text-muted">Waiting for approval</span>
                                }
                            </td>
                        </tr>
                        <tr class="collapse" id="group-@group.Id">
                            <td colspan="6" class="bg-light">
                                @if (!string.IsNullOrWhiteSpace(group.ResolutionNote))
                                {
                                    <div class="small text-muted mb-2">@group.ResolutionNote</div>
                                }

                                <ul class="list-unstyled mb-0">
                                    @foreach (var item in group.Exceptions)
                                    {
                                        <li class="py-1">
                                            <span class="badge text-bg-@DisplayFormats.Badge(item.Status)">@DisplayFormats.Words(item.Status)</span>
                                            <span>@DisplayFormats.ExceptionLabel(item.ExceptionType, item.MissingEventType)</span>
                                            <span class="small text-muted"> · @item.Description</span>
                                            @if (item.ResolutionMethod is not null)
                                            {
                                                <div class="small text-muted ms-2">@DisplayFormats.Words(item.ResolutionMethod)</div>
                                            }
                                        </li>
                                    }
                                </ul>

                                @if (group.CanAccept)
                                {
                                    <form method="post" asp-action="AcceptGroup" class="row g-2 align-items-end mt-2">
                                        <input type="hidden" name="groupId" value="@group.Id" />
                                        @foreach (var (key, value) in Model.ReturnValues)
                                        {
                                            <input type="hidden" name="@key" value="@value" />
                                        }
                                        <div class="col-md-7">
                                            <label class="form-label small mb-0" for="accept-why-@group.Id">Accept all of these as they are: why?</label>
                                            <input id="accept-why-@group.Id" type="text" name="reason" maxlength="1000" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-md-3">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Accept</button>
                                        </div>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
