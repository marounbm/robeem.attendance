@model PayloadFormatsIndexViewModel
@{
    ViewData["Title"] = "File formats";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">File formats</h1>
    <a class="btn btn-primary" asp-action="Create">Add file format</a>
</div>

<p class="text-muted">
    A layout you define for a file the time clock (or any other system) exports: which column holds the employee, the date and time,
    the in/out label, and how the dates are written. Set an integration to <em>Manual file upload</em> and choose the format,
    and the file is read by it on the <em>Upload attendance</em> screen. Punches are still stored exactly as received.
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Formats.Count == 0)
    {
        <div class="card-body text-muted">No file formats yet. <a asp-action="Create">Define the first one.</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">File</th>
                        <th scope="col">Fields separated by</th>
                        <th scope="col" class="text-end">Labels</th>
                        <th scope="col" class="text-end">Integrations</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Formats)
                    {
                        <tr>
                            <td>@item.Name@if (item.Version > 1) { <span class="badge text-bg-light border" title="Changed after punches were read by an earlier version. The earlier versions are kept for those punches.">v@item.Version</span> }<div class="small text-muted">@item.Description</div></td>
                            <td>@item.PayloadKind</td>
                            <td>@item.Delimiter</td>
                            <td class="text-end">@item.EventCodeCount</td>
                            <td class="text-end">@item.IntegrationCount</td>
                            <td><span class="badge text-bg-@(item.IsActive ? "success" : "secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
