@model PayloadFormatsIndexViewModel
@{
    ViewData["Title"] = "Payload formats";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payload formats</h1>
    @if (Model.CanManage)
    {
        <a class="btn btn-primary" asp-action="Create">Add payload format</a>
    }
</div>

<p class="text-muted">
    A layout for a file the time clock (or any other system) exports: which column holds the employee, the date and time,
    the in/out label, and how the dates are written. Set an integration to <em>Manual file upload</em> and choose the format,
    and the file is read by it on the <em>Upload attendance</em> screen. Punches are still stored exactly as received.
</p>

@if (Model.CanManage)
{
    <p class="text-muted">
        The formats are robeem's offering to every tenant: a format you add or change here is available to all of them.
        A change to how a file is read becomes a new version, and a punch that is read again is read the way it was first read.
    </p>
}
else
{
    <p class="text-muted">
        The formats are robeem's offering to every tenant, and are maintained by robeem. You can look at how each one reads a file and
        download an example file to see the layout it expects.
    </p>
}

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Formats.Count == 0)
    {
        <div class="card-body text-muted">
            No payload formats yet.
            @if (Model.CanManage)
            {
                <a asp-action="Create">Define the first one.</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">File</th>
                        <th scope="col">Fields separated by</th>
                        <th scope="col" class="text-end">Labels</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Formats)
                    {
                        <tr>
                            <td>@item.Name@if (item.Version > 1) { <span class="badge text-bg-light border" title="Changed after punches were read by an earlier version. The earlier versions are kept for those punches.">v@item.Version</span> }<div class="small text-muted">@item.Description</div></td>
                            <td>@item.PayloadKind</td>
                            <td>@item.Delimiter</td>
                            <td class="text-end">@item.EventCodeCount</td>
                            <td><span class="badge text-bg-@(item.IsActive ? "success" : "secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">View</a>
                                @if (Model.CanManage)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
