@model PayloadFormatDetailsViewModel
@{
    var format = Model.Format;
    ViewData["Title"] = format.Name;
    var structured = format.PayloadKind is "Json" or "Xml";
    string DelimiterName(string delimiter) => delimiter switch { "," => "commas", ";" => "semicolons", "|" => "vertical bars", "\t" => "tabs", _ => $"'{delimiter}'" };
    string Column(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Replace("|", " / ");
    string Lines(string? value) => string.Join(", ", (value ?? string.Empty).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    var patterns = string.IsNullOrWhiteSpace(format.TimestampFormats)
        ? "Date: " + Lines(format.DateFormats) + " — Time: " + Lines(format.TimeFormats)
        : Lines(format.TimestampFormats);
    var separateColumns = string.IsNullOrWhiteSpace(format.TimestampColumn);
    var culture = format.TimestampCulture ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@format.Name</h1>
    <div>
        @if (Model.CanManage)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        }
        <a class="btn btn-link" asp-action="Index">Back to the list</a>
    </div>
</div>

<p class="text-muted">
    @(string.IsNullOrWhiteSpace(format.Description) ? "This payload format has no description." : format.Description)
    It is maintained by robeem and the same for every tenant, so it is shown here read-only.
</p>

<div class="card mb-3">
    <div class="card-header">Download an example file</div>
    <div class="card-body">
        <p class="small text-muted">
            An example made from this format, with made-up data: its own column names, date patterns and labels. It is the layout
            a file for this format is expected to have.
        </p>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Download" asp-route-id="@Model.Id" asp-route-kind="csv">CSV</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Download" asp-route-id="@Model.Id" asp-route-kind="json">JSON</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Download" asp-route-id="@Model.Id" asp-route-kind="xml">XML</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">How a file is read</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">File kind</dt>
            <dd class="col-sm-8">@format.PayloadKind</dd>

            @if (structured)
            {
                <dt class="col-sm-4">Record path</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(format.RecordPath) ? "The top level" : format.RecordPath)</dd>
            }
            else
            {
                <dt class="col-sm-4">Fields separated by</dt>
                <dd class="col-sm-8">@DelimiterName(format.Delimiter)</dd>

                <dt class="col-sm-4">Header row</dt>
                <dd class="col-sm-8">@(format.HasHeaderRow ? "Yes: columns are named by their headers" : "No: columns are numbered from 1")</dd>
            }

            @if (format.PayloadKind == "Excel")
            {
                <dt class="col-sm-4">Sheet</dt>
                <dd class="col-sm-8">@format.SheetNumber</dd>
            }

            <dt class="col-sm-4">Employee id</dt>
            <dd class="col-sm-8">@Column(format.EmployeeColumn)</dd>

            <dt class="col-sm-4">Timestamp</dt>
            <dd class="col-sm-8">@(separateColumns ? Column(format.DateColumn) + " + " + Column(format.TimeColumn) : Column(format.TimestampColumn))</dd>

            <dt class="col-sm-4">Date patterns</dt>
            <dd class="col-sm-8"><code>@patterns</code>@if (culture.Length > 0) { <span class="text-muted"> (language @culture)</span> }</dd>

            <dt class="col-sm-4">Type</dt>
            <dd class="col-sm-8">@Column(format.TypeColumn)</dd>

            <dt class="col-sm-4">Direction</dt>
            <dd class="col-sm-8">@Column(format.DirectionColumn)</dd>

            <dt class="col-sm-4">Device</dt>
            <dd class="col-sm-8">@Column(format.DeviceColumn)</dd>

            <dt class="col-sm-4">Transaction id</dt>
            <dd class="col-sm-8">@Column(format.TransactionIdColumn)</dd>

            <dt class="col-sm-4">Kept in the payload</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(format.PayloadColumns) ? "Every column (biometric-looking ones are always removed)" : Column(format.PayloadColumns))</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">Labels</div>
    @if (format.EventCodes.Count == 0)
    {
        <div class="card-body text-muted">This format maps no labels.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Label in the file</th>
                        <th scope="col">Means</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var code in format.EventCodes)
                    {
                        <tr>
                            <td><code>@code.Code</code></td>
                            <td>@code.EventType</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
