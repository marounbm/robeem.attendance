@model HolidaysIndexViewModel
@{
    ViewData["Title"] = "Holidays";
}

<h1 class="h3 mb-3">Holidays</h1>

<p class="text-muted">
    The days the whole company does not work. An employee is not expected on a holiday, so a day without punches is not a no-show.
    One row per day: add a holiday of several days with its last day. A date marked <em>to be confirmed</em> follows the moon
    and may still move; edit it when the decree is out.
</p>

<partial name="_StatusMessage" />

<ul class="nav nav-pills mb-3">
    @foreach (var year in Model.Years)
    {
        <li class="nav-item">
            <a class="nav-link @(year == Model.Year ? "active" : string.Empty)" asp-action="Index" asp-route-year="@year">@year</a>
        </li>
    }
</ul>

<div class="card mb-4">
    <div class="card-header">Add a holiday</div>
    <div class="card-body">
        <form method="post" asp-action="Create" class="row g-3 align-items-start">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12 mb-0" role="alert"></div>
            <div class="col-md-3">
                <label asp-for="Input.Date" class="form-label"></label>
                <input asp-for="Input.Date" type="date" value="@Model.Input.Date.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Input.Date" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.LastDate" class="form-label"></label>
                <input asp-for="Input.LastDate" type="date" value="@Model.Input.LastDate?.ToString("yyyy-MM-dd")" class="form-control" />
                <span asp-validation-for="Input.LastDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" maxlength="255" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-2 pt-4">
                <div class="form-check mt-2">
                    <input asp-for="Input.IsProvisional" class="form-check-input" />
                    <label asp-for="Input.IsProvisional" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Add</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    @if (Model.Holidays.Count == 0)
    {
        <div class="card-body text-muted">No holidays in @Model.Year. Add them above.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Holiday</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var holiday in Model.Holidays)
                    {
                        <tr>
                            <td class="text-nowrap">@DisplayFormats.Date(holiday.Date)</td>
                            <td>
                                @holiday.Name
                                @if (holiday.IsProvisional)
                                {
                                    <span class="badge text-bg-warning ms-1" title="This date follows the moon and may still move.">to be confirmed</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@holiday.Id">Edit</a>
                                <form method="post" asp-action="Remove" asp-route-id="@holiday.Id" asp-route-year="@Model.Year" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this holiday?');">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
