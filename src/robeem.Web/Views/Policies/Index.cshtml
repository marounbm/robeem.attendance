@model PoliciesIndexViewModel
@{
    ViewData["Title"] = "Attendance policies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Attendance policies</h1>
    <a class="btn btn-primary" asp-action="Create">Add policy</a>
</div>

<p class="text-muted">
    The rules that turn punches into worked time. The <strong>tenant-wide default</strong> applies to every time schedule that has no
    policy of its own. A change applies to days processed from then on; a day already processed keeps its result until it is reprocessed.
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Policies.Count == 0)
    {
        <div class="card-body text-muted">No policies yet. Without one, built-in defaults apply (no rounding, no grace, no overtime approval). <a asp-action="Create">Add the tenant-wide default.</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Applies to</th>
                        <th scope="col" class="text-end">Rounding</th>
                        <th scope="col" class="text-end">Grace (late / early)</th>
                        <th scope="col" class="text-end">Overtime after</th>
                        <th scope="col">Overtime approval</th>
                        <th scope="col">Corrections by</th>
                        <th scope="col">Unlabeled punches</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var policy in Model.Policies)
                    {
                        <tr>
                            <td><a asp-action="Edit" asp-route-id="@policy.Id">@policy.Title</a></td>
                            <td>
                                @if (policy.IsTenantDefault)
                                {
                                    <span class="badge text-bg-primary">Tenant default</span>
                                }
                                else
                                {
                                    @policy.TimeScheduleTitle
                                }
                            </td>
                            <td class="text-end">@(policy.RoundingRuleMinutes == 0 ? "none" : $"{policy.RoundingRuleMinutes} min")</td>
                            <td class="text-end">@policy.LateGraceMinutes / @policy.EarlyDepartureGraceMinutes min</td>
                            <td class="text-end">@policy.OvertimeThresholdMinutes min</td>
                            <td>@(policy.RequiresOvertimePreApproval ? "Approval first" : "Not needed")</td>
                            <td>@policy.CorrectionApprovalWorkflow</td>
                            <td>@(policy.UnlabeledPunchInterpretationMode == "Off" ? "Left for review" : "Sequential")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@policy.Id">Edit</a>
                                @if (!policy.IsTenantDefault)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@policy.Id" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this policy? Its schedule will follow the tenant-wide default.');">Delete</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
