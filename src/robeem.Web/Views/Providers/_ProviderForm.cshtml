@model ProviderFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="card mb-3">
    <div class="card-header">Provider</div>
    <div class="card-body row g-3">
        <div class="col-md-6">
            <label asp-for="Input.DisplayName" class="form-label"></label>
            <input asp-for="Input.DisplayName" class="form-control" autocomplete="off" placeholder="e.g. ZKTeco" />
            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.ProviderKey" class="form-label"></label>
            @if (Model.Id is null)
            {
                <input asp-for="Input.ProviderKey" class="form-control font-monospace" autocomplete="off" placeholder="e.g. my-clock" />
                <div class="form-text">
                    Lower-case letters, digits, <code>.</code> <code>_</code> <code>-</code>. Can't be changed later. A vendor pulled over an API or pushing
                    webhooks needs a code adapter registered under exactly this key; a vendor of exported files needs none.
                </div>
            }
            else
            {
                <input type="hidden" asp-for="Input.ProviderKey" />
                <input class="form-control font-monospace" value="@Model.Input.ProviderKey" disabled />
                <div class="form-text">The key can't be changed: a code adapter and the punches it produced are tied to it.</div>
            }
            <span asp-validation-for="Input.ProviderKey" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Manufacturer" class="form-label"></label>
            <input asp-for="Input.Manufacturer" class="form-control" autocomplete="off" />
            <span asp-validation-for="Input.Manufacturer" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.WebsiteUrl" class="form-label"></label>
            <input asp-for="Input.WebsiteUrl" class="form-control" autocomplete="off" placeholder="https://" />
            <span asp-validation-for="Input.WebsiteUrl" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.DefaultFileFormatId" class="form-label"></label>
            <select asp-for="Input.DefaultFileFormatId" class="form-select">
                <option value="">None</option>
                @foreach (var format in Model.FileFormats)
                {
                    <option value="@format.Id" selected="@(format.Id == Model.Input.DefaultFileFormatId)">@format.Name</option>
                }
            </select>
            <div class="form-text">
                How an uploaded file of this provider is read when its integration names no format of its own.
                <a asp-controller="FileFormats" asp-action="Index">Define a file format.</a>
            </div>
            <span asp-validation-for="Input.DefaultFileFormatId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <div class="form-label">Transports</div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" checked disabled id="transport-FileUpload" />
                <label class="form-check-label" for="transport-FileUpload">Manual file upload <span class="text-muted">(every provider has it)</span></label>
            </div>
            @* A transport an administrator switched off is offered only to the provider that already has it. *@
            @foreach (var transport in Model.Transports.Where(t => t.Key != "FileUpload" && (t.IsActive || Model.Input.Transports.Contains(t.Key))))
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="Input.Transports" value="@transport.Key" id="transport-@transport.Key"
                           checked="@Model.Input.Transports.Contains(transport.Key)" />
                    <label class="form-check-label" for="transport-@transport.Key">
                        @transport.DisplayName
                        @if (!transport.IsActive)
                        {
                            <span class="text-muted">(switched off: untick to remove it, it can't be added back)</span>
                        }
                    </label>
                </div>
            }
            <div class="form-text">The other ways an integration of this provider can receive attendance. Each needs code behind it. A switched-off transport is not offered; <a asp-controller="Transports" asp-action="Index">switch it on again</a> to use it.</div>
            <span asp-validation-for="Input.Transports" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <div class="form-check">
                <input asp-for="Input.SupportsWebhooks" class="form-check-input" />
                <label asp-for="Input.SupportsWebhooks" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-check">
                <input asp-for="Input.SupportsIncrementalSync" class="form-check-input" />
                <label asp-for="Input.SupportsIncrementalSync" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label"></label>
            </div>
            <div class="form-text">An inactive provider can't be chosen for a new integration; integrations that already use it keep working.</div>
        </div>
    </div>
</div>
