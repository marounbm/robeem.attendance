@model LeavesIndexViewModel
@{
    ViewData["Title"] = "Leaves";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Leaves</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-employeeId="@Model.EmployeeId">Add leave</a>
</div>

<p class="text-muted">
    Time employees are away with approval. A leave saved here counts as approved. On a leave day an employee is not expected, so a day
    without punches is not a no-show.
</p>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    @if (Model.EmployeeId is { } employeeId)
    {
        <input type="hidden" name="employeeId" value="@employeeId" />
    }
    <div class="col-sm-6 col-md-3">
        <label class="form-label small mb-0" for="search">Employee</label>
        <input type="search" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Number or name" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="from">From</label>
        <input type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="to">To</label>
        <input type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="type">Type</label>
        <select id="type" name="type" class="form-select">
            <option value="">All</option>
            @foreach (var type in LeavesIndexViewModel.LeaveTypes)
            {
                <option value="@type" selected="@(type == Model.LeaveType)">@type</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select" title="Per page">
            @foreach (var size in LeavesIndexViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size per page</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<div class="card">
    @if (Model.Leaves.Count == 0)
    {
        <div class="card-body text-muted">No leaves found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Employee</th>
                        <th scope="col">Type</th>
                        <th scope="col">First day</th>
                        <th scope="col">Last day</th>
                        <th scope="col">Hours</th>
                        <th scope="col">Notes</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var leave in Model.Leaves)
                    {
                        <tr>
                            <td>@leave.EmployeeName <span class="text-muted small">(@leave.EmployeeNumber)</span></td>
                            <td>@leave.LeaveType</td>
                            <td class="text-nowrap">@DisplayFormats.Date(leave.StartDate)</td>
                            <td class="text-nowrap">@DisplayFormats.Date(leave.EndDate)</td>
                            <td class="text-nowrap">@(leave.IsPartDay ? $"{leave.StartTime}–{leave.EndTime}" : "Whole day")</td>
                            <td>@leave.Notes</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@leave.Id">Edit</a>
                                <form method="post" asp-action="Remove" asp-route-id="@leave.Id" asp-route-employeeId="@Model.EmployeeId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this leave?');">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
