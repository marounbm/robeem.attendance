@model ReviewsQueueViewModel
@{
    ViewData["Title"] = "Reviews";
}

<h1 class="h3 mb-1">Records to review</h1>
<p class="text-muted">
    The system does not approve these by itself: overtime that needs pre-approval, work on a day with no shift, or a day
    still incomplete. Approve what is right, or reject it with a reason. An approval covers exactly what you see: if the
    day changes afterwards, it needs a new review. A record with an open exception is not shown until the exception is settled.
</p>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small mb-0" for="employeeId">Employee</label>
        <select id="employeeId" name="employeeId" class="form-select">
            <option value="">All employees</option>
            @foreach (var employee in Model.Employees)
            {
                <option value="@employee.Id" selected="@(employee.Id == Model.EmployeeId)">@employee.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="why">Why</label>
        <select id="why" name="why" class="form-select">
            <option value="">Any reason</option>
            @foreach (var reason in ReviewsQueueViewModel.Reasons)
            {
                <option value="@reason" selected="@(reason == Model.Why)">@DisplayFormats.Words(reason)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="from">From</label>
        <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="to">To</label>
        <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select">
            @foreach (var size in ReviewsQueueViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="card-body text-muted">@(Model.Total == 0 && (Model.EmployeeId is not null || Model.From is not null || Model.To is not null || Model.Why is not null) ? "No record matches." : "Nothing is waiting for your review.")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Employee</th>
                        <th scope="col">Day</th>
                        <th scope="col">Why</th>
                        <th scope="col">Scheduled</th>
                        <th scope="col">Worked</th>
                        <th scope="col">Overtime</th>
                        <th scope="col"><span class="visually-hidden">Decide</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.EmployeeName</td>
                            <td class="text-nowrap">@DisplayFormats.Date(item.AttendanceDate)</td>
                            <td><span class="badge text-bg-warning">@DisplayFormats.Words(item.Reason)</span></td>
                            <td class="text-nowrap">
                                @if (item.ScheduledStart is not null)
                                {
                                    @($"{DisplayFormats.Time(item.ScheduledStart)}–{DisplayFormats.Time(item.ScheduledEnd)}")
                                }
                                else
                                {
                                    <span class="text-muted">No shift</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @DisplayFormats.Hours(item.WorkingHours)
                                <div class="small text-muted">@DisplayFormats.Time(item.ActualCheckIn)–@DisplayFormats.Time(item.ActualCheckOut)</div>
                            </td>
                            <td>@(item.OvertimeMinutes > 0 ? DisplayFormats.Minutes(item.OvertimeMinutes) : "—")</td>
                            <td class="text-end">
                                <form method="post" asp-action="Decide" class="d-flex gap-1 justify-content-end">
                                    <input type="hidden" name="recordId" value="@item.RecordId" />
                                    @foreach (var (name, value) in Model.ReturnValues)
                                    {
                                        <input type="hidden" name="@name" value="@value" />
                                    }
                                    <input type="text" name="reason" maxlength="1000" class="form-control form-control-sm w-auto"
                                           placeholder="Reason (required to reject)" aria-label="Reason" />
                                    <button type="submit" name="approved" value="true" class="btn btn-sm btn-success">Approve</button>
                                    <button type="submit" name="approved" value="false" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
