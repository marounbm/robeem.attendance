@model ReviewsQueueViewModel
@{
    ViewData["Title"] = "Reviews";
}

<h1 class="h3 mb-1">Records to review</h1>
<p class="text-muted">
    The system does not approve these by itself: overtime that needs pre-approval, work on a day with no shift, or a day
    still incomplete. Approve what is right, or reject it with a reason. An approval covers exactly what you see: if the
    day changes afterwards, it needs a new review. A record with an open exception is not shown until the exception is settled.
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="card-body text-muted">Nothing is waiting for your review.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Employee</th>
                        <th scope="col">Day</th>
                        <th scope="col">Why</th>
                        <th scope="col">Scheduled</th>
                        <th scope="col">Worked</th>
                        <th scope="col">Overtime</th>
                        <th scope="col"><span class="visually-hidden">Decide</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.EmployeeName</td>
                            <td class="text-nowrap">@DisplayFormats.Date(item.AttendanceDate)</td>
                            <td><span class="badge text-bg-warning">@DisplayFormats.Words(item.Reason)</span></td>
                            <td class="text-nowrap">
                                @if (item.ScheduledStart is not null)
                                {
                                    @($"{DisplayFormats.Time(item.ScheduledStart)}–{DisplayFormats.Time(item.ScheduledEnd)}")
                                }
                                else
                                {
                                    <span class="text-muted">No shift</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @DisplayFormats.Hours(item.WorkingHours)
                                <div class="small text-muted">@DisplayFormats.Time(item.ActualCheckIn)–@DisplayFormats.Time(item.ActualCheckOut)</div>
                            </td>
                            <td>@(item.OvertimeMinutes > 0 ? DisplayFormats.Minutes(item.OvertimeMinutes) : "—")</td>
                            <td class="text-end">
                                <form method="post" asp-action="Decide" class="d-flex gap-1 justify-content-end">
                                    <input type="hidden" name="recordId" value="@item.RecordId" />
                                    <input type="text" name="reason" maxlength="1000" class="form-control form-control-sm w-auto"
                                           placeholder="Reason (required to reject)" aria-label="Reason" />
                                    <button type="submit" name="approved" value="true" class="btn btn-sm btn-success">Approve</button>
                                    <button type="submit" name="approved" value="false" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
