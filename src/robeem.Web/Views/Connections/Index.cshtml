@model ConnectionsIndexViewModel
@{
    ViewData["Title"] = "Connections";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Connections</h1>
        <div class="text-muted">
            <a asp-controller="Integrations" asp-action="Details" asp-route-id="@Model.Integration.Id">@Model.Integration.DisplayName</a>
            (@Model.Integration.VendorName)
        </div>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-integrationId="@Model.Integration.Id">Add connection</a>
</div>

<p class="text-muted">
    A connection is where attendance comes from (a file upload, an SFTP folder, a REST API, a webhook, a database or a device agent)
    and how that is authenticated. The <strong>default</strong> connection is the one the integration is pulled or accepted through, and the
    one its devices use unless a device names another. A connection keeps only the <em>name</em> of its secret.
</p>

<partial name="_StatusMessage" />

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Transport</th>
                    <th scope="col">Authentication</th>
                    <th scope="col">Secret reference</th>
                    <th scope="col">Schedule</th>
                    <th scope="col" class="text-end">Devices</th>
                    <th scope="col">Last test</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var connection in Model.Connections)
                {
                    <tr class="@(connection.IsActive ? string.Empty : "text-muted")">
                        <td>
                            <a asp-action="Edit" asp-route-integrationId="@connection.IntegrationId" asp-route-id="@connection.Id">@connection.Name</a>
                            @if (connection.IsDefault)
                            {
                                <span class="badge text-bg-primary">Default</span>
                            }
                            @if (!connection.IsActive)
                            {
                                <span class="badge text-bg-secondary">Off</span>
                            }
                        </td>
                        <td>@connection.TransportName</td>
                        <td>@connection.AuthMethod</td>
                        <td>@if (connection.SecretRef.Length > 0) { <code>@connection.SecretRef</code> } else { <span>—</span> }</td>
                        <td class="text-nowrap"><code>@(connection.PollingSchedule ?? "—")</code></td>
                        <td class="text-end">@connection.DeviceCount</td>
                        <td>
                            @if (connection.LastTestedAt is null)
                            {
                                <span class="text-muted">Not tested</span>
                            }
                            else
                            {
                                <span class="badge text-bg-@(connection.LastTestSucceeded == true ? "success" : "danger")">@(connection.LastTestSucceeded == true ? "Passed" : "Failed")</span>
                                <span class="small" title="@connection.LastTestMessage">@DisplayFormats.DateTime(connection.LastTestedAt)</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-action="Test" asp-route-integrationId="@connection.IntegrationId" asp-route-id="@connection.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Test</button>
                            </form>
                            @if (!connection.IsDefault && connection.IsActive)
                            {
                                <form method="post" asp-action="MakeDefault" asp-route-integrationId="@connection.IntegrationId" asp-route-id="@connection.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Make default</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-integrationId="@connection.IntegrationId" asp-route-id="@connection.Id">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
