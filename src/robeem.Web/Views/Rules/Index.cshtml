@model RulesSettingsViewModel
@{
    ViewData["Title"] = "Rules";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Rules</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Advanced" asp-route-scheduleId="@Model.ScheduleId">Advanced rules</a>
</div>

<partial name="_StatusMessage" />

<ul class="nav nav-pills mb-3">
    @foreach (var scope in Model.Scopes)
    {
        <li class="nav-item">
            <a class="nav-link @(scope.TimeScheduleId == Model.ScheduleId ? "active" : string.Empty)" asp-action="Index" asp-route-scheduleId="@scope.TimeScheduleId">
                @scope.Title
                @if (scope.HasDraft)
                {
                    <span class="badge text-bg-warning ms-1">draft</span>
                }
            </a>
        </li>
    }
</ul>

@if (Model.HasDraft)
{
    <div class="alert alert-warning">
        A draft of these rules is open, so the settings can't be changed here. <a asp-action="Advanced" asp-route-scheduleId="@Model.ScheduleId">Continue the draft or throw it away</a> first.
    </div>
}
else if (!Model.IsStandard)
{
    <div class="alert alert-warning">
        @Model.NotStandardReason <a asp-action="Advanced" asp-route-scheduleId="@Model.ScheduleId">Open the advanced rules</a>.
    </div>
}
else
{
    <form method="post" asp-action="SaveSettings">
        <input type="hidden" name="scheduleId" value="@Model.ScheduleId" />
        <input type="hidden" name="version" value="@Model.Version" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <p class="text-muted">
            <strong>@Model.ScopeTitle</strong>:
            @(Model.Version == 0 ? "the starting settings (nothing saved yet)" : $"settings saved as version {Model.Version}").
        </p>

        <div class="card mb-3">
            <div class="card-header">Breaks: raise an exception for a person to settle when…</div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.LongBreakRaises" class="form-check-input" role="switch" aria-label="A long break raises an exception" /></div>
                    <div>
                        the breaks together run more than
                        <input asp-for="Settings.LongBreakMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes over the scheduled break
                        <span asp-validation-for="Settings.LongBreakMinutesOver" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.LateBreakRaises" class="form-check-input" role="switch" aria-label="A late break raises an exception" /></div>
                    <div>
                        a break starts more than
                        <input asp-for="Settings.LateBreakMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes after its scheduled start
                        <span asp-validation-for="Settings.LateBreakMinutesOver" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.EarlyBreakRaises" class="form-check-input" role="switch" aria-label="An early break raises an exception" /></div>
                    <div>
                        a break starts more than
                        <input asp-for="Settings.EarlyBreakMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes before its scheduled start
                        <span asp-validation-for="Settings.EarlyBreakMinutesOver" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.NoBreakRaises" class="form-check-input" role="switch" aria-label="No break raises an exception" /></div>
                    <div>a shift with a scheduled break is worked with no break punches</div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Arrival, departure and hours: raise an exception for a person to settle when…</div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.ShortHoursRaises" class="form-check-input" role="switch" aria-label="A day worked short raises an exception" /></div>
                    <div>
                        a complete day is worked more than
                        <input asp-for="Settings.ShortHoursMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes short of the scheduled time, once the shift is over
                        <span asp-validation-for="Settings.ShortHoursMinutesOver" class="text-danger small"></span>
                        <div class="form-text">Raise the number to forgive small shortfalls: 60 lets 7 hours worked of an 8-hour shift pass.</div>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.LateCheckInRaises" class="form-check-input" role="switch" aria-label="A late check-in raises an exception" /></div>
                    <div>
                        a check-in is more than
                        <input asp-for="Settings.LateCheckInMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes after the shift starts (after the late grace of the policy)
                        <span asp-validation-for="Settings.LateCheckInMinutesOver" class="text-danger small"></span>
                        <div class="form-text">Separate from the rule above: a late day can raise both.</div>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.EarlyCheckOutRaises" class="form-check-input" role="switch" aria-label="An early check-out raises an exception" /></div>
                    <div>
                        a check-out is more than
                        <input asp-for="Settings.EarlyCheckOutMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes before the shift ends (after the early-departure grace of the policy)
                        <span asp-validation-for="Settings.EarlyCheckOutMinutesOver" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.OvertimeRaises" class="form-check-input" role="switch" aria-label="Overtime raises an exception" /></div>
                    <div>
                        a complete day is worked more than
                        <input asp-for="Settings.OvertimeMinutesOver" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes longer than scheduled (after the overtime threshold of the policy)
                        <span asp-validation-for="Settings.OvertimeMinutesOver" class="text-danger small"></span>
                        <div class="form-text">In addition to the policy's "approval first" for overtime, which still sends the day to the Approvals queue.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Absence and unscheduled work: raise an exception for a person to settle when…</div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.UnscheduledWorkRaises" class="form-check-input" role="switch" aria-label="Work with no scheduled shift raises an exception" /></div>
                    <div>
                        someone not paid by the hour punches when no shift is scheduled for them (a day off, a holiday, or no schedule)
                        <div class="form-text">In addition to the review the day already waits for in the Approvals queue.</div>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.NoShowRaises" class="form-check-input" role="switch" aria-label="A no-show raises an exception" /></div>
                    <div>
                        nobody punched for a scheduled shift,
                        <input asp-for="Settings.NoShowWaitMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes after the shift ends
                        <span asp-validation-for="Settings.NoShowWaitMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input type="checkbox" class="form-check-input" role="switch" checked disabled aria-label="A missing check-out always raises an exception" /></div>
                    <div>
                        someone is still checked in
                        <input asp-for="Settings.MissingCheckOutWaitMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes after the shift ends
                        <span class="text-muted small">(always on: raised after 24 hours at the latest)</span>
                        <span asp-validation-for="Settings.MissingCheckOutWaitMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">How breaks are read</div>
            <div class="list-group list-group-flush">
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.ShortBreakIsWork" class="form-check-input" role="switch" aria-label="A short break counts as work" /></div>
                    <div>
                        Count a break shorter than
                        <input asp-for="Settings.ShortBreakMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes as work (a toilet visit), not as the break
                        <span asp-validation-for="Settings.ShortBreakMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.GapIsBreak" class="form-check-input" role="switch" aria-label="A gap is read as the break" /></div>
                    <div>
                        For a machine that sends no break types (chosen on each <a asp-controller="Devices" asp-action="Index">device</a>), read the middle-of-the-day check-out and the next check-in as the break-out and break-in when the gap starts within
                        <input asp-for="Settings.GapWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled break and lasts at most
                        <input asp-for="Settings.GapMaxMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes
                        <span asp-validation-for="Settings.GapWindowMinutes" class="text-danger small"></span>
                        <span asp-validation-for="Settings.GapMaxMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Fix obvious punch mistakes automatically</div>
            <div class="list-group list-group-flush">
                <div class="list-group-item small text-muted">
                    Off to begin with. A fix only changes how a punch is read for the day: the punch the machine sent is kept as it was, a fixed punch is marked as inferred, and no punch is ever made up.
                    A punch a person added or corrected is never changed. These need a scheduled shift, so hourly staff are not affected. Two punches are read first and a lone punch after that,
                    and only one fix reads a pair. Numbers of minutes are measured from the punch that is kept.
                </div>

                <div class="list-group-item bg-body-tertiary fw-semibold">Start of the day</div>
                <div class="list-group-item">
                    <div>
                        Two check-ins at the start, no more than
                        <input asp-for="Settings.MorningDuplicateGapMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes apart, the one that is kept within
                        <input asp-for="Settings.MorningDuplicateWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled start:
                        <span asp-validation-for="Settings.MorningDuplicateGapMinutes" class="text-danger small"></span>
                        <span asp-validation-for="Settings.MorningDuplicateWindowMinutes" class="text-danger small"></span>
                    </div>
                    <div class="mt-1">
                        <div class="form-check form-check-inline"><input asp-for="MorningPairKeeps" type="radio" value="Nothing" id="morning-nothing" class="form-check-input" /><label class="form-check-label" for="morning-nothing">Do nothing</label></div>
                        <div class="form-check form-check-inline"><input asp-for="MorningPairKeeps" type="radio" value="First" id="morning-first" class="form-check-input" /><label class="form-check-label" for="morning-first">Keep the first, leave the second out</label></div>
                        <div class="form-check form-check-inline"><input asp-for="MorningPairKeeps" type="radio" value="Last" id="morning-last" class="form-check-input" /><label class="form-check-label" for="morning-last">Keep the last, leave the first out</label></div>
                    </div>
                    <div class="small text-muted mt-1">Keeping the first also covers a check-in followed by a check-out within the same minutes: the check-out is left out.</div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.MorningOutThenInCounts" class="form-check-input" role="switch" aria-label="A check-out then a check-in at the start: keep the check-in" /></div>
                    <div>
                        A check-out then a check-in at the start, no more than
                        <input asp-for="Settings.MorningOutThenInGapMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes apart, the check-in within
                        <input asp-for="Settings.MorningOutThenInWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled start: leave the check-out out and keep the check-in
                        <span asp-validation-for="Settings.MorningOutThenInGapMinutes" class="text-danger small"></span>
                        <span asp-validation-for="Settings.MorningOutThenInWindowMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.LoneCheckOutIsCheckIn"class="form-check-input" role="switch" aria-label="A lone check-out near the start is read as the check-in" /></div>
                    <div>
                        A day with a check-out within
                        <input asp-for="Settings.LoneCheckOutWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled start and no check-in: read it as the check-in
                        <span asp-validation-for="Settings.LoneCheckOutWindowMinutes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="list-group-item bg-body-tertiary fw-semibold">End of the day</div>
                <div class="list-group-item">
                    <div>
                        Two check-outs at the end, no more than
                        <input asp-for="Settings.EveningDuplicateGapMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes apart, the one that is kept within
                        <input asp-for="Settings.EveningDuplicateWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled end:
                        <span asp-validation-for="Settings.EveningDuplicateGapMinutes" class="text-danger small"></span>
                        <span asp-validation-for="Settings.EveningDuplicateWindowMinutes" class="text-danger small"></span>
                    </div>
                    <div class="mt-1">
                        <div class="form-check form-check-inline"><input asp-for="EveningPairKeeps" type="radio" value="Nothing" id="evening-nothing" class="form-check-input" /><label class="form-check-label" for="evening-nothing">Do nothing</label></div>
                        <div class="form-check form-check-inline"><input asp-for="EveningPairKeeps" type="radio" value="First" id="evening-first" class="form-check-input" /><label class="form-check-label" for="evening-first">Keep the first, leave the second out</label></div>
                        <div class="form-check form-check-inline"><input asp-for="EveningPairKeeps" type="radio" value="Last" id="evening-last" class="form-check-input" /><label class="form-check-label" for="evening-last">Keep the last, leave the first out</label></div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div>
                        A check-in (after a check-in, with no check-out between) then a check-out at the end, no more than
                        <input asp-for="Settings.EveningInThenOutGapMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes apart, the one that is kept within
                        <input asp-for="Settings.EveningInThenOutWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled end:
                        <span asp-validation-for="Settings.EveningInThenOutGapMinutes" class="text-danger small"></span>
                        <span asp-validation-for="Settings.EveningInThenOutWindowMinutes" class="text-danger small"></span>
                    </div>
                    <div class="mt-1">
                        <div class="form-check form-check-inline"><input asp-for="EveningInThenOutKeeps" type="radio" value="Nothing" id="inthenout-nothing" class="form-check-input" /><label class="form-check-label" for="inthenout-nothing">Do nothing</label></div>
                        <div class="form-check form-check-inline"><input asp-for="EveningInThenOutKeeps" type="radio" value="First" id="inthenout-first" class="form-check-input" /><label class="form-check-label" for="inthenout-first">Read the check-in as the check-out, leave the check-out out</label></div>
                        <div class="form-check form-check-inline"><input asp-for="EveningInThenOutKeeps" type="radio" value="Last" id="inthenout-last" class="form-check-input" /><label class="form-check-label" for="inthenout-last">Leave the check-in out, keep the check-out</label></div>
                    </div>
                    <div class="small text-muted mt-1">Keeping the check-out uses the punch the machine sent as a check-out, so nothing is marked as inferred.</div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.LoneCheckInIsCheckOut" class="form-check-input" role="switch" aria-label="A lone check-in near the end is read as the check-out" /></div>
                    <div>
                        A day with a check-in within
                        <input asp-for="Settings.LoneCheckInWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled end and no check-out: read it as the check-out
                        <span asp-validation-for="Settings.LoneCheckInWindowMinutes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="list-group-item bg-body-tertiary fw-semibold">Repeated punches, anywhere in the day</div>
                <div class="list-group-item">
                    <div>
                        Two punches of the same kind one after the other, no more than
                        <input asp-for="Settings.RepeatedGapMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes apart. These need no scheduled shift, so staff paid by the hour are read too. The start and end rules above read a pair first; a run of three or more is read until one is left.
                        <span asp-validation-for="Settings.RepeatedGapMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item">
                    <div>Two check-ins:</div>
                    <div class="mt-1">
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckInKeeps" type="radio" value="Nothing" id="repeat-in-nothing" class="form-check-input" /><label class="form-check-label" for="repeat-in-nothing">Do nothing</label></div>
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckInKeeps" type="radio" value="First" id="repeat-in-first" class="form-check-input" /><label class="form-check-label" for="repeat-in-first">Keep the first, leave the later one out</label></div>
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckInKeeps" type="radio" value="Last" id="repeat-in-last" class="form-check-input" /><label class="form-check-label" for="repeat-in-last">Keep the last, leave the earlier one out</label></div>
                        <span asp-validation-for="Settings.RepeatedCheckInLast" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item">
                    <div>Two check-outs:</div>
                    <div class="mt-1">
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckOutKeeps" type="radio" value="Nothing" id="repeat-out-nothing" class="form-check-input" /><label class="form-check-label" for="repeat-out-nothing">Do nothing</label></div>
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckOutKeeps" type="radio" value="First" id="repeat-out-first" class="form-check-input" /><label class="form-check-label" for="repeat-out-first">Keep the first, leave the later one out</label></div>
                        <div class="form-check form-check-inline"><input asp-for="RepeatedCheckOutKeeps" type="radio" value="Last" id="repeat-out-last" class="form-check-input" /><label class="form-check-label" for="repeat-out-last">Keep the last, leave the earlier one out</label></div>
                        <span asp-validation-for="Settings.RepeatedCheckOutLast" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.RepeatedBreakPunchFirst" class="form-check-input" role="switch" aria-label="Two break-outs, or two break-ins, close together: keep the first" /></div>
                    <div>Two break-outs, or two break-ins, one after the other: keep the first and leave the later one out</div>
                </div>

                <div class="list-group-item bg-body-tertiary fw-semibold">Breaks</div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.BreakInIsBreakOut" class="form-check-input" role="switch" aria-label="A break-in near the start of the break is read as the break-out" /></div>
                    <div>
                        A break-in within
                        <input asp-for="Settings.BreakInIsBreakOutWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled start of the break, when no break is open (a break-in said twice, or in place of the break-out): read it as the break-out
                        <span asp-validation-for="Settings.BreakInIsBreakOutWindowMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="list-group-item d-flex gap-3 align-items-center">
                    <div class="form-check form-switch m-0"><input asp-for="Settings.BreakOutIsBreakIn" class="form-check-input" role="switch" aria-label="A break-out near the end of the break is read as the break-in" /></div>
                    <div>
                        A break-out within
                        <input asp-for="Settings.BreakOutIsBreakInWindowMinutes" type="number" min="0" max="1440" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" />
                        minutes of the scheduled end of the break, when a break is already open (a break-out said twice, or in place of the break-in): read it as the break-in
                        <span asp-validation-for="Settings.BreakOutIsBreakInWindowMinutes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>
}

<div class="small text-muted mt-4">
    <ul class="mb-0">
        <li>Saving publishes the settings at once as a new version for @Model.ScopeTitle. Days are calculated with them from now on, and the nightly look-back brings recent days up to date.</li>
        <li>A switch that is off means no exception is raised for it; the finding is still noted on the day.</li>
        <li>These always apply, whatever the settings: a missing check-in, a missing break punch, and punches out of order. A rule can never invent a punch.</li>
        <li>Rules for the company don't reach a schedule that has a policy of its own: choose that schedule above to give it its own settings.</li>
        <li>Conditions, "do not raise" rules, the order of the rules and the earlier versions are in the <a asp-action="Advanced" asp-route-scheduleId="@Model.ScheduleId">advanced rules</a>.</li>
    </ul>
</div>
