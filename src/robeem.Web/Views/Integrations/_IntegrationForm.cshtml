@model IntegrationFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@{
    // Each connector's transports, so the choice offers only what the chosen connector can do. A transport an
    // administrator switched off is offered only to the integration that already has it.
    var supportedByConnector =Model.Connectors.ToDictionary(
        p => p.Id.ToString(),
        p => p.SupportedTransports.Where(t => t.IsActive || t.Key == Model.Input.Transport).Select(t => t.Key).ToArray());
    var transports = Model.Connectors.SelectMany(p => p.SupportedTransports).GroupBy(t => t.Key).Select(g => g.First()).ToList();
    var pullingTransports = transports.Where(t => t.IsPull).Select(t => t.Key).ToArray();
    var fileTransports = transports.Where(t => t.UsesPayloadFormat).Select(t => t.Key).ToArray();
    var encryptedConnectors = Model.Connectors.Where(p => p.EncryptionKind != "None").Select(p => p.Id.ToString()).ToArray();
}

<div class="card mb-3">
    <div class="card-header">Connection</div>
    <div class="card-body row g-3">
        <div class="col-md-6">
            <label asp-for="Input.DisplayName" class="form-label"></label>
            <input asp-for="Input.DisplayName" class="form-control" autocomplete="off" />
            <span asp-validation-for="Input.DisplayName" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.ConnectorId" class="form-label"></label>
            @if (Model.Id is null)
            {
                <select asp-for="Input.ConnectorId" class="form-select">
                    @foreach (var connector in Model.Connectors)
                    {
                        <option value="@connector.Id" disabled="@(!connector.IsActive)" selected="@(connector.Id == Model.Input.ConnectorId)">
                            @connector.VendorName — @connector.DisplayName
                        </option>
                    }
                </select>
                <div class="form-text">Only a usable connector can be chosen: active, with a default payload format or a code adapter. <a asp-controller="Connectors" asp-action="Index">Manage connectors.</a></div>
                @foreach (var connector in Model.Connectors.Where(p => p.Manufacturer.Length > 0).GroupBy(p => p.VendorKey).Select(g => g.First()))
                {
                    <div class="form-text">@connector.VendorName: made by @connector.Manufacturer@(connector.WebsiteUrl.Length > 0 ? " (" + connector.WebsiteUrl + ")" : string.Empty).</div>
                }
            }
            else
            {
                <input type="hidden" asp-for="Input.ConnectorId" />
                <input class="form-control" value="@(Model.Connectors.FirstOrDefault(p => p.Id == Model.Input.ConnectorId) is { } chosen ? chosen.VendorName + " — " + chosen.DisplayName : string.Empty)" disabled />
                <div class="form-text">The connector can't be changed: the devices and punches belong to its adapter.</div>
            }
            <span asp-validation-for="Input.ConnectorId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.Transport" class="form-label"></label>
            <select asp-for="Input.Transport" class="form-select" id="integration-transport">
                @foreach (var transport in transports)
                {
                    <option value="@transport.Key" selected="@(transport.Key == Model.Input.Transport)">@transport.DisplayName</option>
                }
            </select>
            <div class="form-text">
                <strong>Manual file upload</strong>: HR uploads the exported file on the <em>Upload attendance</em> screen; only such
                integrations are listed there. It is available for every connector. The other choices are listed only as far as the
                chosen connector supports them. <a asp-controller="Transports" asp-action="Index">Rename or switch off a transport.</a>
            </div>
            <span asp-validation-for="Input.Transport" class="text-danger small"></span>
        </div>
        <partial name="_ConnectionFields" model="@(new ConnectionFieldsModel { AuthMethod = Model.Input.AuthMethod, Settings = Model.Input.Settings, Descriptors = Model.Descriptors, TransportSelectId = "integration-transport" })" />
        <div class="col-md-6" id="integration-file-format">
            <label asp-for="Input.PayloadFormatId" class="form-label"></label>
            <select asp-for="Input.PayloadFormatId" class="form-select">
                <option value="">The connector's default payload format</option>
                @foreach (var format in Model.PayloadFormats)
                {
                    <option value="@format.Id" selected="@(format.Id == Model.Input.PayloadFormatId)">@format.Name</option>
                }
            </select>
            <div class="form-text">
                How the uploaded file is read. A connector with no default payload format needs one chosen here before a file can be uploaded.
                <a asp-controller="PayloadFormats" asp-action="Index">Define a file format.</a>
            </div>
            <span asp-validation-for="Input.PayloadFormatId" class="text-danger small"></span>
        </div>
        <div class="col-md-6" id="integration-default-device">
            <label asp-for="Input.DefaultDeviceId" class="form-label"></label>
            <select asp-for="Input.DefaultDeviceId" class="form-select" disabled="@(Model.Id is null)">
                <option value="">None: look up the device id in the file</option>
                @foreach (var device in Model.Devices)
                {
                    <option value="@device.Id" selected="@(device.Id == Model.Input.DefaultDeviceId)">@device.Name (@device.ExternalDeviceId, @device.TimeZoneId)</option>
                }
            </select>
            <div class="form-text">
                An uploaded file has no physical device: every punch of it is attributed to this device, ignoring the device
                id in the file, and read in its time zone. @(Model.Id is null ? "Create the integration and add its device first, then choose it here." : "Add the device on the Devices page if it is not listed.")
            </div>
            <span asp-validation-for="Input.DefaultDeviceId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.ConnectionConfigRef" class="form-label"></label>
            <input asp-for="Input.ConnectionConfigRef" class="form-control" autocomplete="off" placeholder="e.g. acme-clock-api" />
            <div class="form-text">
                The <em>name</em> the secret is kept under in configuration (user-secrets, environment variable, or a vault).
                Never type the secret itself here. Leave it empty for an integration you only upload files to.
            </div>
            <span asp-validation-for="Input.ConnectionConfigRef" class="text-danger small"></span>
        </div>
        <div class="col-md-6" id="integration-payload-key">
            <label asp-for="Input.PayloadKeyRef" class="form-label"></label>
            <input asp-for="Input.PayloadKeyRef" class="form-control" autocomplete="off" placeholder="e.g. acme-clock-file-key" />
            <div class="form-text">
                This connector's files arrive encrypted. Give the <em>name</em> the decryption key is kept under in configuration, apart from the
                connection secret. PGP: the armored private key (or JSON with <code>privateKey</code> and <code>passphrase</code>). AES: JSON with
                <code>key</code>, optional <code>iv</code> and <code>mode</code> (<code>cbc</code> or <code>gcm</code>), keys in base64. Password-protected zip: the password.
                Never type the key itself here.
            </div>
            <span asp-validation-for="Input.PayloadKeyRef" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.TimeZoneId" class="form-label"></label>
            <input asp-for="Input.TimeZoneId" class="form-control" autocomplete="off" list="integration-time-zones" placeholder="e.g. Asia/Beirut" maxlength="64" />
            <datalist id="integration-time-zones">
                @foreach (var zone in IntegrationDetailsViewModel.CommonTimeZones)
                {
                    <option value="@zone"></option>
                }
            </datalist>
            <div class="form-text">
                The zone a punch with no UTC offset is read in when its device is not registered. A registered device's own zone
                always wins. Leave empty to require a registered device.
            </div>
            <span asp-validation-for="Input.TimeZoneId" class="text-danger small"></span>
        </div>
        <div class="col-md-3" id="integration-schedule">
            <label asp-for="Input.PollingScheduleCron" class="form-label"></label>
            <input asp-for="Input.PollingScheduleCron" class="form-control" autocomplete="off" placeholder="*/5 * * * *" list="cron-examples" />
            <datalist id="cron-examples">
                <option value="*/5 * * * *">every 5 minutes</option>
                <option value="*/15 * * * *">every 15 minutes</option>
                <option value="0 * * * *">every hour</option>
                <option value="0 6 * * *">daily at 06:00</option>
            </datalist>
            <div class="form-text">When to pull from the vendor, in server time. Empty: never pull (uploads only).</div>
            <span asp-validation-for="Input.PollingScheduleCron" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Status" class="form-label"></label>
            <select asp-for="Input.Status" class="form-select">
                <option value="Active">Active</option>
                <option value="Paused">Paused: no sync runs</option>
            </select>
            <div class="form-text">There is no delete: the punches already stored stay.</div>
            <span asp-validation-for="Input.Status" class="text-danger small"></span>
        </div>
    </div>
</div>

<script>
    (function () {
        var supported = @Json.Serialize(supportedByConnector);
        var pulling = @Json.Serialize(pullingTransports);
        var fileBased = @Json.Serialize(fileTransports);
        var encrypted = @Json.Serialize(encryptedConnectors);
        var payloadKey = document.getElementById('integration-payload-key');
        var connector = document.querySelector('[name="Input.ConnectorId"]');
        var transport = document.getElementById('integration-transport');
        var schedule = document.getElementById('integration-schedule');
        var fileFormat = document.getElementById('integration-file-format');
        var defaultDevice = document.getElementById('integration-default-device');

        function refresh() {
            var allowed = supported[connector.value] || [];
            Array.prototype.forEach.call(transport.options, function (option) {
                var ok = allowed.indexOf(option.value) >= 0;
                option.hidden = !ok;
                option.disabled = !ok;
            });
            if (allowed.length > 0 && allowed.indexOf(transport.value) < 0) {
                transport.value = allowed[0];
            }
            schedule.hidden = pulling.indexOf(transport.value) < 0;
            fileFormat.hidden = fileBased.indexOf(transport.value) < 0;
            defaultDevice.hidden = fileBased.indexOf(transport.value) < 0;
            payloadKey.hidden = encrypted.indexOf(connector.value) < 0;
        }

        connector.addEventListener('change', refresh);
        transport.addEventListener('change', refresh);
        refresh();
    })();
</script>
