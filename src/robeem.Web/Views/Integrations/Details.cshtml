@model IntegrationDetailsViewModel
@{
    var integration = Model.Integration;
    var health = Model.Health;
    ViewData["Title"] = integration.DisplayName;
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">@integration.DisplayName</h1>
        <div class="text-muted">
            @integration.VendorName
            · <span class="badge text-bg-@(integration.Status == "Active" ? "success" : integration.Status == "Failed" ? "danger" : "secondary")">@integration.Status</span>
            · <span class="badge text-bg-light border">@integration.TransportName</span>
            @if (integration.PayloadFormatName is not null)
            {
                <span>· file format <strong>@integration.PayloadFormatName</strong></span>
            }
            @if (integration.DefaultDeviceName is not null)
            {
                <span>· device for uploads <strong>@integration.DefaultDeviceName</strong></span>
            }
            · time zone <code>@(integration.TimeZoneId ?? "none")</code>
            · schedule <code>@(integration.PollingScheduleCron ?? "none")</code>
            @if (!string.IsNullOrEmpty(integration.ConnectionConfigRef))
            {
                <span>· secret reference <code>@integration.ConnectionConfigRef</code></span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@integration.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-controller="Connections" asp-action="Index" asp-route-integrationId="@integration.Id" title="Where this integration's attendance comes from and how that is authenticated. A device may use another connection than the default.">Connections (@integration.ConnectionCount)</a>
        <a class="btn btn-outline-secondary" asp-action="RawMapping" asp-route-id="@integration.Id" title="Each raw punch beside the normalized punch it produced. Opening it is written to the audit log.">Raw → normalized</a>
        <form method="post" asp-action="RetryFailed" asp-route-id="@integration.Id">
            <button type="submit" class="btn btn-outline-secondary" title="Normalize again the punches that failed for want of a time zone, after setting the integration's time zone or registering the device. Other failures are not retried.">Retry failed punches</button>
        </form>
        <form method="post" asp-action="RenormalizeFlagged" asp-route-id="@integration.Id">
            <button type="submit" class="btn btn-outline-secondary" title="Punches flagged for an unrecognized device are left out of the attendance days. After choosing the device for uploaded files (or registering the device), this reads them again; the old flagged punches stay as history, marked Replaced.">Re-normalize flagged punches</button>
        </form>
        <form method="post" asp-action="Run" asp-route-id="@integration.Id">
            <input type="hidden" name="reconcile" value="false" />
            <button type="submit" class="btn btn-outline-primary">Sync now</button>
        </form>
        <form method="post" asp-action="Run" asp-route-id="@integration.Id">
            <input type="hidden" name="reconcile" value="true" />
            <button type="submit" class="btn btn-outline-primary" title="Re-pull the last two days, to catch late punches">Reconcile now</button>
        </form>
    </div>
</div>

<partial name="_StatusMessage" />

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span>Health, last @(health is null ? "day" : $"{(health.WindowEnd - health.WindowStart).TotalHours:0} hours")</span>
        <span>
            <span class="badge text-bg-@DisplayFormats.Badge(integration.HealthStatus)">@integration.HealthStatus</span>
            @if (health?.IsCircuitOpen == true)
            {
                <span class="badge text-bg-danger">Circuit open: the vendor is not being called</span>
            }
        </span>
    </div>
    <div class="card-body">
        @if (health is null)
        {
            <p class="text-muted mb-0">No health report.</p>
        }
        else
        {
            <div class="row g-3 text-center">
                <div class="col-6 col-md-2"><div class="h5 mb-0">@DisplayFormats.Percent(health.SyncSuccessRate)</div><div class="small text-muted">Sync success (@health.FailedSyncs of @health.Syncs failed)</div></div>
                <div class="col-6 col-md-2"><div class="h5 mb-0">@DisplayFormats.Percent(health.FailedTransactionRate)</div><div class="small text-muted">Punches unusable (@health.TransactionsFailed of @health.TransactionsReceived)</div></div>
                <div class="col-6 col-md-2"><div class="h5 mb-0">@DisplayFormats.Percent(health.DuplicateRate)</div><div class="small text-muted">Duplicates (@health.Duplicates of @health.TransactionsNormalized)</div></div>
                <div class="col-6 col-md-2"><div class="h5 mb-0">@DisplayFormats.Percent(health.MissingEventRate)</div><div class="small text-muted">Days with a missing punch (@health.MissingPunchExceptions of @health.EmployeeDays)</div></div>
                <div class="col-6 col-md-2"><div class="h5 mb-0">@DisplayFormats.Delay(health.AverageSyncDelaySeconds)</div><div class="small text-muted">Average delay, punch to receipt</div></div>
                <div class="col-6 col-md-2"><div class="h5 mb-0">@health.UnresolvedExceptions</div><div class="small text-muted">Unresolved exceptions</div></div>
            </div>
            <div class="small text-muted mt-3">
                Last successful sync: @DisplayFormats.DateTime(health.LastSuccessfulSyncAt).
                @if (health.LastFailureMessage is not null)
                {
                    <span>Last failure @DisplayFormats.DateTime(health.LastFailureAt): @health.LastFailureMessage</span>
                }
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Devices</div>
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            This integration has <strong>@integration.DeviceCount</strong> device(s) and <strong>@integration.MappingCount</strong> employee-id mapping(s).
            <div class="small text-muted">
                Devices, their time zones and the mapping of the vendor's employee ids to employees are kept per device, on the Devices page.
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-controller="Devices" asp-action="Index" asp-route-integrationId="@integration.Id">Devices</a>
            <a class="btn btn-outline-secondary" asp-controller="Devices" asp-action="Create" asp-route-integrationId="@integration.Id">Add device</a>
        </div>
    </div>
</div>

<a asp-action="Index">Back to integrations</a>
