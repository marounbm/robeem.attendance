@model IntegrationsIndexViewModel
@{
    ViewData["Title"] = "Integrations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Integrations</h1>
    <a class="btn btn-primary" asp-action="Create">Add integration</a>
</div>

<p class="text-muted">
    A connection to a time-clock provider: how to reach it, when to pull from it, which devices it has, and which of your
    employees its employee ids stand for. Punches are always stored as received; nothing here changes stored punches.
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Integrations.Count == 0)
    {
        <div class="card-body text-muted">No integrations yet. <a asp-action="Create">Add the first one.</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Provider</th>
                        <th scope="col">Receives by</th>
                        <th scope="col">Status</th>
                        <th scope="col">Health</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Last sync</th>
                        <th scope="col" class="text-end">Devices</th>
                        <th scope="col" class="text-end">Mappings</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Integrations)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@item.Id">@item.DisplayName</a></td>
                            <td>@item.ProviderName</td>
                            <td>@DisplayFormats.Transport(item.Transport)</td>
                            <td><span class="badge text-bg-@(item.Status == "Active" ? "success" : item.Status == "Failed" ? "danger" : "secondary")">@item.Status</span></td>
                            <td><span class="badge text-bg-@DisplayFormats.Badge(item.HealthStatus)">@item.HealthStatus</span></td>
                            <td class="text-nowrap"><code>@(item.PollingScheduleCron ?? "—")</code></td>
                            <td class="text-nowrap">@DisplayFormats.DateTime(item.LastSuccessfulSyncAt)</td>
                            <td class="text-end">@item.DeviceCount</td>
                            <td class="text-end">@item.MappingCount</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Open</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
