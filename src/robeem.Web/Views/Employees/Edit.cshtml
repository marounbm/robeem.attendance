@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Edit employee";
}

<h1 class="h3 mb-3">Edit employee <small class="text-muted">@Model.Input.EmployeeNumber</small></h1>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    <partial name="_EmployeeForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
