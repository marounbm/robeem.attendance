@model EmployeeIndexViewModel
@inject robeem.Web.Actors.ICurrentActor Actor
@{
    ViewData["Title"] = "Employees";

    // The link to an employee's attendance is shown only to someone who may open the Attendance screen (the menu and the access filter use the same rule).
    var attendanceScreen = NavigationMenu.Find("Records");
    var canOpenAttendance = attendanceScreen is not null && NavigationMenu.AccessTo(Actor, attendanceScreen) == NavAccess.Allowed;

    (EmployeeSortField Field, string Title)[] columns =
    [
        (EmployeeSortField.Number, "Number"),
        (EmployeeSortField.Name, "Name"),
        (EmployeeSortField.Department, "Department"),
        (EmployeeSortField.JobTitle, "Job title"),
        (EmployeeSortField.TimeSchedule, "Time schedule"),
        (EmployeeSortField.Manager, "Manager"),
        (EmployeeSortField.HireDate, "Hire date"),
        (EmployeeSortField.Status, "Status"),
    ];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-primary" asp-action="Create">Add employee</a>
</div>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-3">
    @* Searching keeps the sort; the page starts again at the first. *@
    <input type="hidden" name="sort" value="@EmployeeIndexViewModel.SortName(Model.Sort)" />
    <input type="hidden" name="dir" value="@(Model.Descending ? "desc" : "asc")" />
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search number, name, email, department" aria-label="Search employees" />
    </div>
    <div class="col-auto form-check ms-2">
        <input type="checkbox" class="form-check-input" id="includeInactive" name="includeInactive" value="true"
               checked="@Model.IncludeInactive" />
        <label class="form-check-label" for="includeInactive">Include inactive</label>
    </div>
    <div class="col-auto">
        <label class="visually-hidden" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select" title="Per page">
            @foreach (var size in EmployeeIndexViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size per page</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card">
    @if (Model.Employees.Count == 0)
    {
        <div class="card-body text-muted">
            No employees found. <a asp-action="Create">Add the first one.</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        @* The headings sort the whole list (on the server, before it is cut into pages); press one again to turn the order round. *@
                        @foreach (var (field, title) in columns)
                        {
                            <th scope="col" aria-sort="@Model.AriaSort(field)">
                                <a asp-action="Index" asp-all-route-data="Model.SortLink(field)" class="text-reset text-decoration-none">@title@(Model.Sort != field ? string.Empty : Model.Descending ? " ▼" : " ▲")</a>
                            </th>
                        }
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td>@employee.EmployeeNumber</td>
                            <td>@employee.FullName</td>
                            <td>@employee.Department</td>
                            <td>@employee.JobTitle</td>
                            <td>
                                @(employee.TimeScheduleTitle ?? "—")
                                @if (employee.PayBasis == "Hourly")
                                {
                                    <span class="badge text-bg-info ms-1" title="Paid by the hours worked; not compared with a schedule.">hourly</span>
                                }
                            </td>
                            <td>@(employee.ManagerName ?? "—")</td>
                            <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                                @if (canOpenAttendance)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Records" asp-action="Index" asp-route-employeeId="@employee.Id" title="The calculated days of @employee.FullName">Attendance</a>
                                }
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Leaves" asp-action="Index" asp-route-employeeId="@employee.Id">Leave</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
