@model EmployeeIndexViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-primary" asp-action="Create">Add employee</a>
</div>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search number, name, email, department" aria-label="Search employees" />
    </div>
    <div class="col-auto form-check ms-2">
        <input type="checkbox" class="form-check-input" id="includeInactive" name="includeInactive" value="true"
               checked="@Model.IncludeInactive" />
        <label class="form-check-label" for="includeInactive">Include inactive</label>
    </div>
    <div class="col-auto">
        <label class="visually-hidden" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select" title="Per page">
            @foreach (var size in EmployeeIndexViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size per page</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<div class="card">
    @if (Model.Employees.Count == 0)
    {
        <div class="card-body text-muted">
            No employees found. <a asp-action="Create">Add the first one.</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Number</th>
                        <th scope="col">Name</th>
                        <th scope="col">Department</th>
                        <th scope="col">Job title</th>
                        <th scope="col">Time schedule</th>
                        <th scope="col">Manager</th>
                        <th scope="col">Hire date</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td>@employee.EmployeeNumber</td>
                            <td>@employee.FullName</td>
                            <td>@employee.Department</td>
                            <td>@employee.JobTitle</td>
                            <td>@(employee.TimeScheduleTitle ?? "—")</td>
                            <td>@(employee.ManagerName ?? "—")</td>
                            <td>@employee.HireDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (employee.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
