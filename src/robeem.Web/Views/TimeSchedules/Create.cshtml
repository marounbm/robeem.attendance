@model TimeScheduleFormViewModel
@{
    ViewData["Title"] = "Add time schedule";
}

<h1 class="h3 mb-3">Add time schedule</h1>

<p class="text-muted">
    Start with the name and how long the pattern is. The schedule is created with a team for everyone, so employees can be assigned
    to it straight away. You add its shifts and set its roster on the next page.
</p>

<form method="post" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_ScheduleSettings" for="Input" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
