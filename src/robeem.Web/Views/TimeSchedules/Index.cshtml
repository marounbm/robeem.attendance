@model TimeSchedulesIndexViewModel
@{
    ViewData["Title"] = "Time schedules";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Time schedules</h1>
    <a class="btn btn-primary" asp-action="Create">Add time schedule</a>
</div>

<p class="text-muted">
    When people are expected to work. A schedule has <strong>shifts</strong> (a start, an end and an optional break), a
    <strong>pattern</strong> that repeats (usually one week) and a <strong>roster</strong> that says which shifts are worked on which
    day of the pattern. Every day of attendance is calculated against the schedule its employee is assigned to
    (<a asp-controller="Employees" asp-action="Index">Employees</a>).
</p>

<partial name="_StatusMessage" />

<div class="card">
    @if (Model.Schedules.Count == 0)
    {
        <div class="card-body text-muted">No time schedules yet. <a asp-action="Create">Add the first one.</a></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Pattern</th>
                        <th scope="col" class="text-end">Shifts</th>
                        <th scope="col" class="text-end">Teams</th>
                        <th scope="col" class="text-end">Employees</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schedule in Model.Schedules)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@schedule.Id">@schedule.Title</a>
                                @if (schedule.IsSystemSchedule)
                                {
                                    <span class="badge text-bg-secondary">System</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(schedule.Description))
                                {
                                    <div class="small text-muted">@schedule.Description</div>
                                }
                            </td>
                            <td>@(schedule.CyclePeriod == 7 ? "Weekly" : $"{schedule.CyclePeriod} days")</td>
                            <td class="text-end">@schedule.ShiftCount</td>
                            <td class="text-end">@schedule.TeamCount</td>
                            <td class="text-end">@schedule.EmployeeCount</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@schedule.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
