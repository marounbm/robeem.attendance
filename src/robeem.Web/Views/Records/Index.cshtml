@model RecordsIndexViewModel
@{
    ViewData["Title"] = "Attendance";


    // The column headings sort the whole list (on the server, before it is cut into pages) by that column; pressing one again turns the order round.
    (string Title, RecordSortField Field, string Class)[] columns =
    [
        ("Date", RecordSortField.Date, string.Empty),
        ("Employee", RecordSortField.Employee, string.Empty),
        ("Worked", RecordSortField.Worked, "text-end"),
        ("Overtime", RecordSortField.Overtime, "text-end"),
        ("Break", RecordSortField.Break, "text-end"),
        ("Exceptions", RecordSortField.Exceptions, "text-end"),
        ("Status", RecordSortField.Status, string.Empty),
    ];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Attendance</h1>
</div>

<partial name="_AttendanceTabs" model="@("Days")" />

<p class="text-muted">
    One line per employee and day, oldest first unless you sort by another column (press a column heading; press it again to turn the order round):
    the hours worked out from the punches and the schedule. You see your own
    days; a manager also sees their reports'; HR sees everyone's. Open a day to see how it was calculated.
    A day with an open exception shows as <strong>Open exceptions</strong>: press <strong>Resolve</strong> to correct its punches (or accept a break exception) from the day itself, and only
    then does it come to <em>Approvals</em> if it still needs a decision. <strong>Pending review</strong> is a day that does.
</p>

<partial name="_StatusMessage" />

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    @* Filtering keeps the sort; the page starts again at the first. *@
    <input type="hidden" name="sort" value="@RecordsIndexViewModel.SortName(Model.Sort)" />
    <input type="hidden" name="dir" value="@(Model.Descending ? "desc" : "asc")" />
    <div class="col-auto">
        <label class="form-label small mb-0" for="employeeId">Employee</label>
        <select id="employeeId" name="employeeId" class="form-select">
            <option value="">All employees</option>
            @foreach (var employee in Model.Employees)
            {
                <option value="@employee.Id" selected="@(employee.Id == Model.EmployeeId)">@employee.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="status">Status</label>
        <select id="status" name="status" class="form-select">
            @foreach (var status in RecordsIndexViewModel.Statuses)
            {
                <option value="@status" selected="@(status == Model.Status)">@DisplayFormats.Words(status)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="from">From</label>
        <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="to">To</label>
        <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input id="onlyWithExceptions" type="checkbox" name="onlyWithExceptions" value="true" class="form-check-input" checked="@Model.OnlyWithExceptions" />
            <label class="form-check-label" for="onlyWithExceptions">Only days with an open exception</label>
        </div>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0" for="pageSize">Per page</label>
        <select id="pageSize" name="pageSize" class="form-select">
            @foreach (var size in RecordsIndexViewModel.PageSizes)
            {
                <option value="@size" selected="@(size == Model.PageSize)">@size</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="card-body text-muted">No days match.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        @foreach (var column in columns)
                        {
                            <th scope="col" class="@column.Class" aria-sort="@Model.AriaSort(column.Field)">
                                <a asp-action="Index" asp-all-route-data="Model.SortLink(column.Field)" class="text-reset text-decoration-none">@column.Title@(Model.Sort != column.Field ? string.Empty : Model.Descending ? " ▼" : " ▲")</a>
                            </th>
                        }
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-nowrap">@item.AttendanceDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.EmployeeName <span class="small text-muted">@item.EmployeeNumber</span></td>
                            <td class="text-end">@DisplayFormats.Hours(item.TotalWorkingHours)</td>
                            <td class="text-end">@DisplayFormats.Hours(item.TotalOvertimeHours)</td>
                            <td class="text-end">@DisplayFormats.Hours(item.TotalBreakHours)</td>
                            <td class="text-end">@(item.ExceptionCount == 0 ? "—" : item.ExceptionCount.ToString())</td>
                            <td><span class="badge text-bg-@DisplayFormats.DayStatusBadge(item.Status, item.ExceptionCount, item.HasPendingApproval)" title="@DisplayFormats.DayStatusHint(item.Status, item.ExceptionCount, item.HasPendingApproval)">@DisplayFormats.DayStatus(item.Status, item.ExceptionCount, item.HasPendingApproval)</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm @(item.ExceptionCount > 0 ? "btn-primary" : "btn-outline-primary")" asp-action="Day" asp-route-employeeId="@item.EmployeeId"
                                   asp-route-date="@item.AttendanceDate.ToString("yyyy-MM-dd")">@(item.ExceptionCount > 0 ? "Resolve" : "Open")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Pager" />
