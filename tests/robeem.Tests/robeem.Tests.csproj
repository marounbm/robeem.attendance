  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.4" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Overrides the transitive 2.1.11 native SQLite build (GHSA-2m69-gcr7-jv3q, no patched 2.1.x). -->
